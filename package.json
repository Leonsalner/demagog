{
  "name": "demagog-tool",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.vitest.json",
    "typecheck:all": "npm run typecheck && npm run typecheck:test",
    "title:articles": "tsx scripts/title-clanky.ts",
    "embed:articles": "tsx scripts/embed-articles.ts",
    "embed:statements": "tsx scripts/embed-statements.ts",
    "clear:vyroky": "tsx scripts/clear-vyroky.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.98.0",
    "framer-motion": "^12.38.0",
    "next": "16.2.1",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.4",
    "csv-parse": "^5.6.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "jsdom": "^28.1.0",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vitest": "^4.0.18"
  }
}
